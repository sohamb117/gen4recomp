// Version information shown in Explorer's file properties.
// NP_VERSION_MAJOR/MINOR/PATCH and NP_VERSION_STRING come from shell/CMakeLists.txt.
#include <winver.h>

#define NP_STR2(x) #x
#define NP_STR(x) NP_STR2(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION NP_VERSION_MAJOR, NP_VERSION_MINOR, NP_VERSION_PATCH, 0
PRODUCTVERSION NP_VERSION_MAJOR, NP_VERSION_MINOR, NP_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "nativeplat contributors"
            VALUE "FileDescription", "nativeplat"
            VALUE "FileVersion", NP_STR(NP_VERSION_STRING)
            VALUE "InternalName", "nativeplat"
            VALUE "LegalCopyright", "nativeplat contributors, GPL-3.0-or-later"
            VALUE "OriginalFilename", "nativeplat.exe"
            VALUE "ProductName", "nativeplat"
            VALUE "ProductVersion", NP_STR(NP_VERSION_STRING)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
