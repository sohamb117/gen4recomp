-    &reg_G2S_DB_BG0CNT, &reg_G2S_DB_BG1CNT, &reg_G2S_DB_BG2CNT, &reg_G2S_DB_BG3CNT
-};
+REGType16v * const NNSiG2dBGCNTTable[8] __attribute__((section(".data.g2dbgcnt")));

