# wasm32 build of Pokémon HeartGold / SoulSilver for the nativeplat runtime.
#
#   make -f pc/Makefile.wasm -j6                          build/pc-wasm/pokeheartgold.wasm
#   make -f pc/Makefile.wasm -j6 GAME_VERSION=SOULSILVER  build/pc-wasm/pokesoulsilver.wasm
#
# (run from games/heartgold, after the ROM build: tools/rom_build.sh
# heartgold|soulsilver, whose main.elf.xMAP is the source of every guest
# address and whose generated headers the C and the assembly include).
#
# Built the way Diamond/Pearl are (games/diamond/pc/Makefile.wasm explains
# the structure): the decompiled C through the typed bridge, the remaining
# assembly through armrec, the machine model shared with Platinum and D/P.
# The pieces:
#
#   pc/mk/game.mk     HG/SS's decompiled C (src/, lib/NitroSDK/src/{os,mi},
#                     lib/dsprot/src), from main.lsf's object list
#   pc/mk/armrec.mk   every linked .s (asm/, lib/asm, lib/*/asm) and the
#                     mwcc asm bodies, through armrec
#   games/diamond/pc/mk/bridge.mk  the IR bridge, used as it is
#   games/diamond/pc/mk/host.mk    the machine model (Platinum's pc/src,
#                     pc/hw, pc/wasm/src, armrec_rt.c, D/P's pc/src), used
#                     as it is, by reference, exactly as the ROM-only core
#                     (games/ndsrec) uses it
#
# What differs from D/P: HG/SS link NitroSDK 4.2 (071210) and keep almost
# all of it as assembly (lib/asm/nitro.s), where D compiles its 3.2 SDK
# from C. The host layer's SDK replacements therefore displace recompiled
# functions (armrec --host-override, pc/host_overrides.txt), not weak C;
# and the host compiles with PC_HOST_SDK42, which selects the 4.2 card
# command block where D/P need their 3.2 one (pc_card_rom.c).

ROOT    := $(abspath $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))/..)
NPROOT  := $(abspath $(ROOT)/../..)
PLAT    := $(NPROOT)/games/platinum
DP      := $(NPROOT)/games/diamond
ARMREC  := $(PLAT)/tools/armrec
# Diamond's pc/ directory: bridge.mk and host.mk read their sources, shadow
# headers and the D/P host files from here.
PCDIR   := $(DP)/pc
MYPC    := $(ROOT)/pc

TOOLCHAINS ?= $(NPROOT)/.cache/toolchains
WASI_SDK   ?= $(TOOLCHAINS)/wasi-sdk
WABT       ?= $(TOOLCHAINS)/wabt
PYTHON     ?= python3

GAME_VERSION ?= HEARTGOLD
GAME_LANGUAGE := ENGLISH
ifeq ($(GAME_VERSION),HEARTGOLD)
VER := heartgold
else ifeq ($(GAME_VERSION),SOULSILVER)
VER := soulsilver
else
$(error GAME_VERSION must be HEARTGOLD or SOULSILVER)
endif

BUILD  := $(ROOT)/build/pc-wasm/$(VER)
OBJ    := $(BUILD)/obj
TARGET := $(ROOT)/build/pc-wasm/poke$(VER).wasm
# The ROM build's own outputs: the xMAP is the source of every address.
ROMBUILD := $(ROOT)/build/$(VER).us
ROM_XMAP := $(ROMBUILD)/main.elf.xMAP
ROM_NDS  := $(ROMBUILD)/poke$(VER).nds
LSF      := $(ROOT)/main.lsf
HG_LSF   := $(MYPC)/tools/hg_lsf.py

# Compiles go through tools/ccache.sh when it says so (its header); the flags
# stamp (mk/game.mk) leaves it out.
CCACHE := $(shell $(NPROOT)/tools/ccache.sh --enabled)
CC  := $(strip $(CCACHE) $(WASI_SDK)/bin/clang --target=wasm32-wasip1)
NM  := $(WASI_SDK)/bin/llvm-nm

WASM_ABI := -fno-short-enums -fsigned-char -fno-common -std=gnu99 \
            -fms-extensions -fno-strict-aliasing -fwrapv -w \
            -Wno-error=implicit-function-declaration -Wno-error=implicit-int \
            -Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
            -Wno-error=incompatible-function-pointer-types \
            -Wno-error=return-type -Wno-error=return-mismatch
OPT    ?= -O2
HW_OPT ?= -O3

np_abi_const = $(shell printf '%d' $$(sed -n 's/^\#define $(1) \(0x[0-9A-Fa-f]*\)u.*/\1/p' $(NPROOT)/core/include/np_guest_abi.h))
NP_C_BASE := $(call np_abi_const,NP_GUEST_C_BASE)
NP_MEMORY := $(call np_abi_const,NP_GUEST_MEMORY_BYTES)
WASM_MAP  := $(BUILD)/poke$(VER).map
LDFLAGS   := -Wl,--global-base=$(NP_C_BASE) -Wl,--no-stack-first \
             -Wl,--initial-memory=$(NP_MEMORY) -Wl,--max-memory=$(NP_MEMORY) \
             -Wl,-z,stack-size=1048576 -Wl,-Map=$(WASM_MAP)
LDLIBS    := -lm

.DEFAULT_GOAL := all
.PHONY: all clean wasm2c-check
.SECONDEXPANSION:

OBJS :=
include $(PCDIR)/mk/bridge.mk
include $(MYPC)/mk/game.mk
include $(MYPC)/mk/armrec.mk
include $(PCDIR)/mk/host.mk

# host.mk is D/P's: its D-only pieces swapped for HG/SS's.
#  * PC_HOST_SDK42: the 4.2 card command block (pc_card_rom.c).
#  * host.mk's overlay-statics table walks arm9/overlays/*/src, which this
#    tree does not have; HG/SS's overlay membership is main.lsf's, so the
#    map comes from pc/tools/hg_lsf.py (`hg/<flat>.c <ovl>`, the flat names
#    gen_overlay_statics.py gives $(OBJ)/game/<path>.o).
#  * D/P's decompiled half (games/diamond/pc/game: the field options, the
#    save lab, the heap checker) is not here; the shared layer's calls into
#    it are answered inertly by the ROM-only core's hooks file
#    (games/ndsrec/pc/src/pc_ndsrec_hooks.c), compiled from its own path.
HOST_CFLAGS += -DPC_HOST_SDK42
# PC_CARD_READ_TIME: card reads take time and deliver the VBlanks a long read
# spans (pc_card_rom.c card_read_elapse); FieldMap_Init's VBlank-queue tasks
# overflow the 32-entry queue without it.
HOST_CFLAGS += -DPC_CARD_READ_TIME

HG_OVMAP := $(BUILD)/host/hg-overlay-map.txt
HG_OVSTATICS_C := $(BUILD)/host/hg_overlay_statics.c
HG_OVSTATICS_O := $(OBJ)/host/hg_overlay_statics.o
$(HG_OVMAP): $(LSF) $(HG_LSF)
	@mkdir -p $(dir $@)
	$(PYTHON) $(HG_LSF) $(LSF) ovmap > $@.tmp && mv $@.tmp $@
$(HG_OVSTATICS_C): $(HG_OVMAP) $(PLAT)/pc/gen_overlay_statics.py $(GAME_OBJS)
	@mkdir -p $(dir $@)
	$(PYTHON) $(PLAT)/pc/gen_overlay_statics.py --addr-table $(HG_OVMAP) $(OBJ)/game $@
$(HG_OVSTATICS_O): $(HG_OVSTATICS_C)
	@mkdir -p $(dir $@)
	$(CC) $(HOST_CFLAGS) -c -o $@ $<
LINK_EXTRA_DEPS := $(filter-out $(HOST_OVSTATICS_O),$(LINK_EXTRA_DEPS)) $(HG_OVSTATICS_O)
LINK_EXTRA_OBJS := $(filter-out $(HOST_OVSTATICS_O),$(LINK_EXTRA_OBJS)) $(HG_OVSTATICS_O)

HG_HOST_OBJS := $(OBJ)/hghost/pc_ndsrec_hooks.o
$(OBJ)/hghost/%.o: $(NPROOT)/games/ndsrec/pc/src/%.c $(BRIDGE_DEPS) $(HOST_PRE)
	$(call BRIDGE_COMPILE,$(HOST_CFLAGS) $(HOST_DEPFLAGS))
OBJS += $(HG_HOST_OBJS)
-include $(addsuffix .d,$(HG_HOST_OBJS))

# The GBA slot: HG/SS link no CTRDG backup library (no migration from the
# GBA games), so the slot is the empty one the ROM-only core uses for a ROM
# without it (games/ndsrec/pc/src/pc_ndsrec_noagb.c), in place of D/P's
# flash-chip model.
OBJS := $(filter-out $(HOST_OBJ)/pc/pc_agb_slot.o $(HOST_OBJ)/dp/pc_dp_agb.o,$(OBJS)) \
        $(OBJ)/hghost/pc_ndsrec_noagb.o

# HG/SS's own (pc/src), compiled as game C (bridged): the anti-piracy
# overlay's entry points as a genuine console answers them (their callbacks
# can be recompiled functions), and crt0's OSi_ReferSymbol.
HG_GAME_HOST_OBJS := $(OBJ)/hgsrc/pc_hg_dsprot.o $(OBJ)/hgsrc/pc_hg_crt0.o
$(OBJ)/hgsrc/%.o: $(MYPC)/src/%.c $(GAME_DEPS) $(BRIDGE_DEPS)
	$(call BRIDGE_COMPILE,$(GAME_CFLAGS) $(GAME_GLB_DEFINES) $(GAME_DEPFLAGS))
$(OBJ)/hgsrc/%.o.fpflow: $(MYPC)/src/%.c $(GAME_DEPS) $(FPFLOW)
	$(call FPFLOW_FACTS,$(GAME_CFLAGS) $(GAME_GLB_DEFINES),pc/src/$*.c)
OBJS += $(HG_GAME_HOST_OBJS)
-include $(addsuffix .d,$(HG_GAME_HOST_OBJS))

# The field half of the runtime's options and the tests/e2e probe
# (pc/src/pc_hg_field.c): game C with the game's own defines, as src/ is.
HG_FIELD_OBJ := $(OBJ)/hgsrc/pc_hg_field.o
$(HG_FIELD_OBJ): $(MYPC)/src/pc_hg_field.c $(GAME_DEPS) $(BRIDGE_DEPS)
	$(call BRIDGE_COMPILE,$(GAME_CFLAGS) $(GAME_GF_DEFINES) $(GAME_GLB_DEFINES) $(GAME_DEPFLAGS))
$(HG_FIELD_OBJ).fpflow: $(MYPC)/src/pc_hg_field.c $(GAME_DEPS) $(FPFLOW)
	$(call FPFLOW_FACTS,$(GAME_CFLAGS) $(GAME_GF_DEFINES) $(GAME_GLB_DEFINES),pc/src/pc_hg_field.c)
OBJS += $(HG_FIELD_OBJ)
-include $(HG_FIELD_OBJ).d

# Every C TU's flow facts (pc/mk/game.mk), for hg_fpflow_lint.py at link.
HG_FPFLOW := $(GAME_FPFLOW) $(addsuffix .fpflow,$(HG_GAME_HOST_OBJS) $(HG_FIELD_OBJ))
-include $(wildcard $(addsuffix .fpflow.d,$(HG_GAME_HOST_OBJS) $(HG_FIELD_OBJ)))

# Each C file's overlay (main.lsf's), for dp_ovlabel_lint.py --ovmap.
HG_C_OVERLAYS := $(BUILD)/host/hg-c-overlays.txt
$(HG_C_OVERLAYS): $(LSF) $(HG_LSF)
	@mkdir -p $(dir $@)
	$(PYTHON) $(HG_LSF) $(LSF) c > $@.tmp && mv $@.tmp $@

all: $(TARGET)

# The overlay statics' addresses into the finished module and the contract
# check, as on D/P, after the lints. Each lint exits 1 on a finding its
# allow file (pc/<lint>_allow.txt, one reason per entry) does not explain.
# D/P's (games/diamond/pc/tools, see their headers and D/P's Makefile.wasm)
# read the assembly armrec translates (the staged overlay copies, patched)
# and the mwcc asm bodies extracted from C:
#
# dp_arity_lint: a C call into assembly passing fewer argument words than
#   the assembly reads on entry (the bridge passes 0 where ARM left a
#   register: Route 30's trainer approach, sub_02064598, and five more,
#   pc/patches/src/{scrcmd_battle,field_system,unk_0204A3F4,
#   overlay_44_*}.c.patch).
# dp_retwidth_lint: a C call into assembly through a return type narrower
#   than the value, where mwcc's caller (the ROM object in $(ROMBUILD))
#   uses the bits the bridge narrows away (the friend group id,
#   pc/patches/src/save_rankings.c.patch).
# dp_voidret_lint: assembly reading r0 after calling C the decomp declared
#   void, where mwcc left the value the assembly wants (the map's prop
#   animations and a movement's field effect, pc/patches/src/field/
#   overlay_01_{02204004,021FFECC}.c.patch).
# dp_adjacency_lint: assembly reaching past a C-defined object (laid out
#   by wasm-ld, not as on the ROM).
# dp_ovlabel_lint --xmap: what still binds a cross-overlay reference by
#   name though another overlay the code can have resident has a function
#   at that address: decompiled C naming another overlay's function (a call
#   or a function pointer), assembly storing decompiled C of another
#   overlay (`.word`, armrec's armrec_ext_), assembly calls armrec
#   --overlay-dispatch does not dispatch; overlays and functions from the
#   xMAP, each C file's overlay from main.lsf.
# hg_fpflow_lint.py (pc/tools): a C indirect call whose wasm type differs
#   from a C function the flow lets reach it (call_indirect traps: the
#   communication club and custom Safari Zone callbacks,
#   pc/patches/src/overlay_03); the facts are per TU (pc/mk/game.mk).
HG_LINT_ASM = $(ARMREC_S) $(EXTRACTED_ASM)
HG_LINT_C = $(addprefix $(ROOT)/,$(GAME_DIRECT)) $(GAME_PREP:%=$(BUILD)/prep/%) \
            $(MYPC)/src/pc_hg_dsprot.c $(MYPC)/src/pc_hg_crt0.c $(MYPC)/src/pc_hg_field.c
POST_LINK ?= $(PYTHON) $(PCDIR)/tools/dp_arity_lint.py --allow $(MYPC)/arity_allow.txt \
               $(OBJ) $(HG_LINT_ASM) && \
             $(PYTHON) $(PCDIR)/tools/dp_retwidth_lint.py --allow $(MYPC)/retwidth_allow.txt \
               $(OBJ) $(ROMBUILD) $(HG_LINT_ASM) && \
             $(PYTHON) $(PCDIR)/tools/dp_voidret_lint.py --allow $(MYPC)/voidret_allow.txt \
               $(OBJ) $(HG_LINT_ASM) && \
             $(PYTHON) $(PCDIR)/tools/dp_adjacency_lint.py $(WASM_MAP) $(HG_LINT_ASM) && \
             $(PYTHON) $(PCDIR)/tools/dp_ovlabel_lint.py --allow $(MYPC)/ovlabel_allow.txt \
               --xmap $(ROM_XMAP) --ovmap $(HG_C_OVERLAYS) $(HG_LINT_ASM) $(HG_LINT_C) && \
             $(PYTHON) $(FPFLOW) solve --allow $(MYPC)/fpflow_allow.txt $(HG_FPFLOW) && \
             $(PYTHON) $(PLAT)/pc/wasm/patch_ov_addrs.py $(TARGET) $(WASM_MAP) $(HG_OVSTATICS_C) && \
             $(PYTHON) $(PLAT)/pc/wasm/check_module.py $(TARGET) \
               $(NPROOT)/core/include/np_guest_abi.h $(PCDIR)/stubs.list --map $(WASM_MAP)
$(TARGET): $(HG_FPFLOW) $(HG_C_OVERLAYS)
$(TARGET): $(OBJS) $(LINK_EXTRA_DEPS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LINK_EXTRA_OBJS) $(LDLIBS)
	@$(POST_LINK)

W2C_DIR := $(BUILD)/wasm2c
wasm2c-check: $(TARGET)
	@mkdir -p $(W2C_DIR)
	$(WABT)/bin/wasm-validate $(TARGET)
	$(WABT)/bin/wasm2c $(TARGET) -n $(VER) -o $(W2C_DIR)/$(VER).c
	$(PYTHON) $(NPROOT)/tools/wasm2c_postprocess.py $(W2C_DIR)/$(VER).c
	clang -O1 -c -w -I$(WABT)/include -I$(WABT)/share/wabt/wasm2c \
	    -o $(W2C_DIR)/$(VER).o $(W2C_DIR)/$(VER).c
	rm -rf $(W2C_DIR)

clean:
	rm -rf $(BUILD) $(TARGET)
