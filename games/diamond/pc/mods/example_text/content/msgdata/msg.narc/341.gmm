<?xml version="1.0"?>
<body language="English">
	<row id="narc_0341_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hello, and welcome!\nThis is a runtime content package.\rEverything Rowan says here comes\nfrom /content, not the cartridge.\r</language>
	</row>
	<row id="narc_0341_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I am still Professor Rowan.\rThe words, however, were loaded by\nnativeplat’s package loader.\rBefore we go on, shall I explain\nhow this game is played?\rAsk and I will tell you.\r</language>
	</row>
	<row id="narc_0341_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Moves your character.\nAlso picks between choices\nand menu headings.\n\nConfirms a choice, talks,\nchecks things and moves\nthe text along.\n\nBacks out of a choice or\nleaves a mode.</language>
	</row>
	<row id="narc_0341_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Opens the menu.\n\nUses a registered item,\nsuch as the Bicycle.</language>
	</row>
	<row id="narc_0341_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The lower screen is the\nTouch Screen.\n\nIt shows buttons that change\nwith what you are doing.</language>
	</row>
	<row id="narc_0341_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">When this mark appears in the\nmessage window, there are\nbuttons to touch on the\nTouch Screen below.</language>
	</row>
	<row id="narc_0341_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{YESNO 0}</language>
	</row>
	<row id="narc_0341_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is that all clear so far?{YESNO 0}</language>
	</row>
	<row id="narc_0341_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Touch one of the buttons on\nthe Touch Screen, please.{YESNO 0}</language>
	</row>
	<row id="narc_0341_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Is there anything else you\nwould like to hear about?\r</language>
	</row>
	<row id="narc_0341_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A world full of adventure is\nwaiting for you, and this story\nis yours alone.</language>
	</row>
	<row id="narc_0341_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Talk to everyone and look\neverywhere: towns, routes,\nand caves.\nHints are hidden all over\nthe place.</language>
	</row>
	<row id="narc_0341_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Helping others, meeting\nchallenges and solving puzzles\nwill open new roads.</language>
	</row>
	<row id="narc_0341_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now and then someone will\nchallenge you to a battle,\nand wild creatures may block\nyour path.\n\nGetting past them will make\nyou stronger.</language>
	</row>
	<row id="narc_0341_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">But growing strong is not\nthe whole of the journey.</language>
	</row>
	<row id="narc_0341_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Along the way you will meet\nmany people, and through\nthem you will grow.\n\nThat is what this journey\nis really about.</language>
	</row>
	<row id="narc_0341_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Creatures called Pokémon\nlive all over this world.\r</language>
	</row>
	<row id="narc_0341_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I have a Poké Ball here.\rPlease touch the button in the\nmiddle of the Poké Ball.{YESNO 0}</language>
	</row>
	<row id="narc_0341_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Not that one!\nThe button on the Poké Ball.{YESNO 0}</language>
	</row>
	<row id="narc_0341_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">People and Pokémon live\nside by side here.\rSometimes they play,\nand sometimes they\fwork together.\rSome battle alongside their\nPokémon and grow\fcloser that way.\rAnd I?\rI study Pokémon, so that we\nmay understand them better.\r</language>
	</row>
	<row id="narc_0341_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Now, tell me a little\nabout yourself.\r</language>
	</row>
	<row id="narc_0341_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Are you a boy?\nOr a girl?\r</language>
	</row>
	<row id="narc_0341_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A boy, then?\r</language>
	</row>
	<row id="narc_0341_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A girl, then?\r</language>
	</row>
	<row id="narc_0341_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What is your name?\r</language>
	</row>
	<row id="narc_0341_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So your name is {STRVAR_1 3, 0}?\r</language>
	</row>
	<row id="narc_0341_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">So your name is {STRVAR_1 3, 0}?\r</language>
	</row>
	<row id="narc_0341_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Very well...\nYou are {STRVAR_1 3, 0}.\rA good name!\rAnd this boy here...\nhe is your friend, I believe.\r</language>
	</row>
	<row id="narc_0341_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">What is his name?\r</language>
	</row>
	<row id="narc_0341_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 1}, then?\nThat is your friend’s name?\r</language>
	</row>
	<row id="narc_0341_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well then, {STRVAR_1 3, 0}, it is\ntime.\rYour own adventure is about\nto begin.\rYou will meet many Pokémon\nand many people.\rAnd you may learn a thing or\ntwo along the way, perhaps\feven about yourself.\rGo on, then: into the world\nof Pokémon!\r</language>
	</row>
	<row id="narc_0341_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">CONTROLS</language>
	</row>
	<row id="narc_0341_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">ADVENTURE</language>
	</row>
	<row id="narc_0341_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NOTHING</language>
	</row>
	<row id="narc_0341_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">YES</language>
	</row>
	<row id="narc_0341_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">NO</language>
	</row>
	<row id="narc_0341_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pick a name!</language>
	</row>
	<row id="narc_0341_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Rook</language>
	</row>
	<row id="narc_0341_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ferris</language>
	</row>
	<row id="narc_0341_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Orrin</language>
	</row>
	<row id="narc_0341_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Taddeo</language>
	</row>
	<row id="narc_0341_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Bram</language>
	</row>
	<row id="narc_0341_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Quill</language>
	</row>
	<row id="narc_0341_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ansel</language>
	</row>
	<row id="narc_0341_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pip</language>
	</row>
</body>
