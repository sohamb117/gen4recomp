GX_g3_util.c stores the geometry engine's matrix commands through a cached
pointer, `reg_ptr = &reg_G3_X; *reg_ptr = a; *reg_ptr = b; ...`, one FIFO push
per store. Under the register shadow (pc/include/pc_dp_registers.h) the
address is a staging word, so every store but the last was lost. The pointer
becomes the port address and each store an armrec_gx_store() call.

--- a/GX_g3_util.c
+++ b/GX_g3_util.c
@@ -3,6 +3,15 @@
 #include "gx.h"
 #include "code32.h"
 
+/* wasm port (pc/patches): a geometry command port written repeatedly through
+ * a cached pointer is a FIFO push per store, which a plain store into the
+ * armrec staging word cannot express (each would overwrite the last; the
+ * model then saw 1 of MTX_LOAD_4x4's 16 parameters). The pointer is the real
+ * port address and every store goes through armrec_gx_store(), the entry
+ * point recompiled code uses for the same stores. */
+void armrec_gx_store(u32 a, u32 v, int size);
+#define PC_G3_PORT_STORE(p, v) armrec_gx_store((u32)(p), (u32)(v), 4)
+
