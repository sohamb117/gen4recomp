+int NARC_FindID(const char *path) {
+    int i;
+    int n = (int)(sizeof sNarcFileList / sizeof sNarcFileList[0]);
+
+    if (path == NULL || path[0] == '\0') {
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        if (sNarcFileList[i] != NULL && strcmp(sNarcFileList[i], path) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
