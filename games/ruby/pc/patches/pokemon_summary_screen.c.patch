-NAKED
+// nativeplat: pokeruby keeps sub_80A1334/sub_80A1500 as asm only (the C
+// draft above is not equivalent); the two tasks slide the move-info panel of
+// the battle- and contest-moves pages. C from the asm: same stores, calls and
+// order, including the second test after DestroyTask.
+static void SlideMoveInfoPanel(u8 taskId, u8 *vram, const u8 *tiles, u8 page)
+{
+    s16 *data = gTasks[taskId].data;
+    s16 n;
+    u8 i;
+    u8 *dst;
+
+    data[1] += data[0];
+    if (data[1] < 0)
+        n = 0;
+    else if (data[1] > 10)
+        n = 10;
+    else
+        n = data[1];
+
+    if (n > 0)
+    {
+        dst = vram + (10 - n) * 2;
+        for (i = 0; i < 7; i++)
+        {
+            CpuSet(tiles + (i + 13) * 64, dst, n & 0x1FFFFF);
+            dst += 0x40;
+        }
+    }
+
+    if (n <= 9)
+    {
+        u16 fill;
+
+        dst = vram;
+        for (i = 0; i < 7; i++)
+        {
+            fill = data[2];
+            CpuSet(&fill, dst, ((10 - n) & 0x1FFFFF) | 0x1000000);
+            dst += 0x40;
+        }
+    }
+    else
+    {
+        Menu_EraseWindowRect(0, 19, 9, 19);
+    }
+
+    if (data[0] == 0 || data[1] < 0)
+    {
+        if (pssData.page == page)
+        {
+            Menu_EraseWindowRect(0, 14, 9, 18);
+            sub_80A0958(&pssData.loadedMon);
+            if (GetMonStatusAndPokerus(&pssData.loadedMon))
+                SummaryScreen_PrintColoredText(gOtherText_Status, 13, 1, 18);
+        }
+        DestroyTask(taskId);
+    }
+
+    if (data[1] > 9)
+    {
+        if (pssData.page == page)
+            sub_80A00F4(data[3]);
+        sub_80A0428(&pssData.loadedMon, (u8 *)&data[3]);
+        DestroyTask(taskId);
+    }
+}
