+// nativeplat: instant text (NP_OPT_TEXT_INSTANT): a window the player can
+// speed up prints its characters up to the next wait at once
 static u8 UpdateWindowText(struct Window *win)
 {
+    u8 ret = UpdateWindowTextOnce(win);
+    int n = 0;
+
+    if (gba_option(NP_OPT_TEXT_INSTANT) && PlayerCanInterruptDelay(win))
+    {
+        while (!ret && win->state == WIN_STATE_CHAR_DELAY && ++n < 1024)
+        {
+            win->delayCounter = 0;
+            win->state = WIN_STATE_NORMAL;
+            ret = UpdateWindowTextOnce(win);
+        }
+    }
+    return ret;
+}
