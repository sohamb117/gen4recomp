+/* pc port: NP_RULE_FIX_BUGS recomputes stats once the form is set (the
+ * documented fix for trainers' Wormadam, Rotom, ... using base-form stats). */
+#define PC_NP_FIX_FORM_STATS(mon)                    \
+    do {                                             \
+        if (pc_np_opt.rules & PC_NP_RULE_FIX_BUGS) { \
+            Pokemon_CalcStats(mon);                  \
+        }                                            \
+    } while (0)
+
