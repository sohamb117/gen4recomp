+int NARC_FindID(const char *path)
+{
+    int i;
+    int n = (int)(sizeof sNarcPaths / sizeof sNarcPaths[0]);
+
+    if (path == NULL || path[0] == '\0') {
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        if (sNarcPaths[i] != NULL && strcmp(sNarcPaths[i], path) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
