+#include "pc_np_options.h"
+
+/*
+ * pc port: NP_OPT_TEXT_INSTANT. A printing task normally renders one
+ * character per frame (more with a lower delay). Here it keeps rendering
+ * within the frame for as long as RenderText is only handing out characters
+ * or counting down the per-character delay, and stops at anything else: a
+ * wait for the button, a scroll, a pause, the end of the message, or a
+ * control code that has something for the callback. So a box fills at
+ * once, and every prompt, scroll and scripted pause still behaves as the
+ * game wrote it. Off (the default), this is never called.
+ */
+static enum RenderResult PcNp_RushPrinter(TextPrinter *printer, enum RenderResult result)
+{
+    BOOL printed = FALSE;
+    int i;
+
+    for (i = 0; i < 4096; i++) {
+        if (result == RENDER_PRINT) {
+            printed = TRUE;
+        } else if (result != RENDER_UPDATE) {
+            break; /* finished */
+        }
+        if (printer->state != 0 || printer->callbackParam != 0) {
+            break; /* left RENDER_STATE_HANDLE_CHAR, or the callback is wanted */
+        }
+        printer->delayCounter = 0;
+        result = TextPrinter_Render(printer);
+    }
+    if (printed) {
+        if (result == RENDER_FINISH) {
+            Window_CopyToVRAM(printer->template.window);
+        } else {
+            result = RENDER_PRINT; /* copy what was drawn, then the callback */
+        }
+    }
+    return result;
+}
