+/* pc port: the digging minigame is started from a comm callback
+ * (Mining_ProcessStartMiningConfirm). First-visit solo never searches, so
+ * that callback never fires; the lab starts the same SysTask the callback
+ * would, once MiningEnv_Init has run. */
+void Mining_StartGameForLab(void)
+{
+    if (sMiningEnv == NULL || sMiningEnv->miningGameTask != NULL) {
+        return;
+    }
+
+    Mining_StartGameTask(sMiningEnv->fieldSystem);
+}
