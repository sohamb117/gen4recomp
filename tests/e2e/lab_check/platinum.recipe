# tests/e2e/lab_check.py: every save-lab verb an e2e milestone uses, once,
# on a Platinum new game. Each line's effect is asserted on the minted save
# (np_save4 dump); keep this and lab_check.py's EXPECT in step.
clock 2024-06-15 13:37:00
name LABCHK
gender GENDER_FEMALE
trainer-id 0x2D431                      # tid 54321, sid 2
money 123456
badge BADGE_ID_COAL
badge BADGE_ID_BEACON
party SPECIES_PIPLUP 25 ITEM_ORAN_BERRY
party SPECIES_BIDOOF 12 ITEM_NONE
party-move 0 3 MOVE_SURF
party-iv 0 0 31
party-iv 0 1 0
party-iv 0 2 15
party-iv 0 3 7
party-iv 0 4 20
party-iv 0 5 3
party-ev 0 0 252
party-ev 0 1 4
party-ev 0 2 0
party-ev 0 3 100
party-ev 0 4 40
party-ev 0 5 255
party-level 1 20
party-item 1 ITEM_POTION
dex-seen SPECIES_GARCHOMP
dex-caught SPECIES_LUCARIO
item ITEM_POTION 5
item ITEM_POKE_BALL 3
item ITEM_TM01 1
item ITEM_HM01 1
item ITEM_BICYCLE 1
register-item ITEM_BICYCLE
# Flags and vars nothing on the way to Jubilife touches: Fantina's TM gift
# (Hearthome gym), a Canalave sailor INIT_NEW_GAME hides, Sandgem's story
# var by name and Route 202's by number (VAR_ROUTE_202_STATE = 0x4087).
flag FLAG_RECEIVED_FANTINA_TM65
clear-flag FLAG_HIDE_CANALAVE_CITY_SAILOR
var VAR_SANDGEM_TOWN_STATE 3
var 0x4087 2
national-dex 1
pokedex 1
poketch POKETCH_APPID_CALCULATOR
poketch POKETCH_APPID_PEDOMETER
map MAP_HEADER_JUBILIFE_CITY 0xB4 0x309 FACE_LEFT
