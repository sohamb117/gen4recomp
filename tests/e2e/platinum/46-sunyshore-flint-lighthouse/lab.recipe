# 46-sunyshore-flint-lighthouse lab start: standalone cumulative state at the end of 45-sandgem-rowan-unlocks-sunyshore.
# Sources: pt_story_early.md 'Cumulative state after milestone N' rows 01-21, then pt_story_late.md deltas per milestone
# (dirs renumbered research N -> N+2). The lab mints on INIT_NEW_GAME (pc/src/pc_lab.c:15-21), so new-game hide flags
# (scripts_init_new_game.s:8-125) are already set; RemoveObject sets an object's hidden_flag (src/scrcmd.c:2359-2369).
# Not mintable: running shoes, journal/bag system flags, Togepi egg, accessories, Pokédex form detection, seen-dex entries.
name GQ
gender GENDER_MALE
trainer-id 31415
money 20000
# rival/counterpart teams pick the TURTWIG variants (src/scrcmd.c:3777-3782)
var VAR_PLAYER_STARTER SPECIES_TURTWIG

# lab party, pt_story_late.md 0.4: Dragon Claw in slot 0 on both (80 BP/100 acc/15 PP, res/moves/dragon_claw/data.json),
# level 100 = no EXP/learn-move/evolution prompts; party mons get the player as OT (pc/src/pc_lab.c:680-686)
party SPECIES_GARCHOMP 100 ITEM_LEPPA_BERRY
party-move 0 0 MOVE_DRAGON_CLAW
party-move 0 1 MOVE_SURF
party-move 0 2 MOVE_STRENGTH
party-move 0 3 MOVE_ROCK_CLIMB
party SPECIES_SALAMENCE 100 ITEM_NONE
party-move 1 0 MOVE_DRAGON_CLAW
party-move 1 1 MOVE_WATERFALL
party-move 1 2 MOVE_ROCK_SMASH
party-move 1 3 MOVE_FLY

