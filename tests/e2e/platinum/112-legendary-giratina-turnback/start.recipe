name GQ
gender GENDER_MALE
trainer-id 26112
money 3000
# post-game: story-cleared only sets the trainer-info bit (pc_lab.c:798-800); every script gate
# checks FLAG_GAME_COMPLETED (src/clear_game.c:204-206, scrcmd_system_flags.c:151, system_flags.c:69-71)
story-cleared 1
flag FLAG_GAME_COMPLETED
# set by the Distortion World story (scripts_distortion_world_giratina_room.s:99); cleared at HoF if not caught
clear-flag FLAG_HIDE_TURNBACK_CAVE_GIRATINA_ROOM_GIRATINA
party SPECIES_GARCHOMP 100 ITEM_NONE
# Ghost/Dragon takes 2x from Dragon (~570 vs ~212 HP) [INFERENCE: hand calc]
party-move 0 0 MOVE_DRAGON_CLAW
# the pillar-room maze is bypassed by the map line
map MAP_HEADER_TURNBACK_CAVE_GIRATINA_ROOM 11 15 FACE_UP
