# Trainer id/money as pc/tests/corpus/egg-generate.recipe: its comment records that mint rolls 1 and 3 are male and female.
name GQ
gender GENDER_MALE
trainer-id 10412
money 9000

badge BADGE_ID_COAL
badge BADGE_ID_FOREST
party SPECIES_BIBAREL 25 ITEM_NONE
party SPECIES_BIBAREL 26 ITEM_NONE
party SPECIES_BIBAREL 27 ITEM_NONE
# MAGBY (Flame Body) stays in the party: 73 hatches this run's egg with it (egg cycles halved, daycare.c
# Party_GetEggCyclesToSubtract). Added last so the three BIBAREL keep their mint rolls (genders).
party SPECIES_MAGBY 20 ITEM_NONE
# the start menu needs the Pokedex and a starter (StartMenu_GetNormalHiddenOptions); the Day Care's party menu
# is the game's own (OpenPartyMenuForDaycare)
pokedex 1
var VAR_PLAYER_STARTER SPECIES_TURTWIG
# inside the Day Care, south of the counter; the lady (9,4) is spoken to across it from (9,6) (tools/probe_map.py)
map MAP_HEADER_POKEMON_DAY_CARE 9 10 FACE_UP
