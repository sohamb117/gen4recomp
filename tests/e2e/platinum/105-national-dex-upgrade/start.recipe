name GQ
gender GENDER_MALE
trainer-id 26105
money 3000
# Rowan stands at (7,5) for lab state >=4 (after Sunyshore, scripts_sunyshore_city.s:35;
# OnTransition moves him only for 2/3, scripts_sandgem_town_pokemon_research_lab.s:23-35)
var VAR_SANDGEM_TOWN_LAB_STATE 4
# required by ReactToPokedex (scripts_sandgem_town_pokemon_research_lab.s:52-58)
flag FLAG_FIRST_ARRIVAL_ETERNA_CITY
flag FLAG_FIRST_ARRIVAL_SUNYSHORE_CITY
# [INFERENCE] the Pokedex itself must be owned for Rowan to react to it
