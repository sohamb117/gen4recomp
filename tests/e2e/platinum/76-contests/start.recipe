# Copy of pc/tests/corpus/contest-win.recipe (trainer id kept so the mint matches the pinned station [INFERENCE: placement may depend on it]).
name GQ
gender GENDER_MALE
trainer-id 20481
money 3000

# kept verbatim from pc/tests/corpus/contest-win.recipe
var VAR_PLAYER_STARTER SPECIES_TURTWIG
party SPECIES_ROSELIA 30 ITEM_RED_SCARF
party-move 0 0 MOVE_THUNDERBOLT
party-move 0 1 MOVE_THUNDER
party-move 0 2 MOVE_SWIFT
party-move 0 3 MOVE_AERIAL_ACE
# condition SLOT MON_DATA_* V (pc_lab.c:902-911)
condition 0 MON_DATA_COOL 255
condition 0 MON_DATA_BEAUTY 255
condition 0 MON_DATA_CUTE 255
condition 0 MON_DATA_SMART 255
condition 0 MON_DATA_TOUGH 255
condition 0 MON_DATA_SHEEN 255
# the Contest Hall lobby after its first visit (Keira and Mom, story 18), below the official contest's
# receptionist (16,4)
var VAR_CONTEST_HALL_LOBBY_STATE 1
map MAP_HEADER_CONTEST_HALL_LOBBY 16 5 FACE_UP
