name GQ
gender GENDER_MALE
trainer-id 26096
money 3000
# post-game: story-cleared only sets the trainer-info bit (pc_lab.c:798-800); every script gate
# checks FLAG_GAME_COMPLETED (src/clear_game.c:204-206, scrcmd_system_flags.c:151, system_flags.c:69-71)
story-cleared 1
flag FLAG_GAME_COMPLETED
badge BADGE_ID_COAL
badge BADGE_ID_FOREST
badge BADGE_ID_COBBLE
badge BADGE_ID_FEN
badge BADGE_ID_RELIC
badge BADGE_ID_MINE
badge BADGE_ID_ICICLE
badge BADGE_ID_BEACON
party SPECIES_GARCHOMP 100 ITEM_NONE
party-move 0 0 MOVE_EARTHQUAKE
party SPECIES_EMPOLEON 62 ITEM_NONE
# one tile north of the SS Spiral sailor (356,247), on the town side (events_snowpoint_city.json): from the
# ship side (356,248) the boarding walk has no ship to board and nothing sails (measured; D/P 93 alike)
map MAP_HEADER_SNOWPOINT_CITY 356 246 FACE_DOWN
