# Diamond story 39-canalave-library-valor-explosion: standalone start (--lab, or no end save from 38-canalave-gym-byron-mine-badge).
# Standard header + lab party + the cumulative state after 38-canalave-gym-byron-mine-badge, then the milestone's start.
# Lab party for S9 (39-44): EMPOLEON 100 knows only Surf, so A-spam never stalls on an empty move (it falls back to Struggle);
# GARCHOMP 100 (Dragon Claw only) is the next healthy attacker and the second slot-0 user in doubles; STARAPTOR 100 carries
# the field moves (Fly for the bridges, Strength for Mt Coronet, Rock Smash, Defog). No battle is required in 39.
name GQ
gender PLAYER_GENDER_MALE
trainer-id 31415
money 20000
party SPECIES_EMPOLEON 100 ITEM_NONE
party-move 0 0 MOVE_SURF
party-move 0 1 MOVE_NONE
party-move 0 2 MOVE_NONE
party-move 0 3 MOVE_NONE
party SPECIES_GARCHOMP 100 ITEM_NONE
party-move 1 0 MOVE_DRAGON_CLAW
party-move 1 1 MOVE_NONE
party-move 1 2 MOVE_NONE
party-move 1 3 MOVE_NONE
party SPECIES_STARAPTOR 100 ITEM_NONE
party-move 2 0 MOVE_FLY
party-move 2 1 MOVE_STRENGTH
party-move 2 2 MOVE_ROCK_SMASH
party-move 2 3 MOVE_DEFOG
# @@PRIOR@@
# -- start --
map MAP_CANALAVE 39 732 FACE_DOWN  # below the gym door (39,731), zone_event 0032 warp 0; 38 ends here after scr_seq 0034 script_4
