# Diamond story 20-route209-to-solaceon: standalone start (--lab, or no end save from 19-hearthome-contest-hall-rival).
# Standard header + lab party + the cumulative state after 19-hearthome-contest-hall-rival, then the milestone's start.
# Applied on top of the D/P new-game base save; names resolve through tests/gameplay/labc.py --game diamond;
# flag/var lines cite the script that sets them.
name GQ
gender PLAYER_GENDER_MALE
trainer-id 31415
money 20000
# Standard lab party: Surf in slot 0 and slots 1-3 cleared, so an empty Surf falls back to Struggle
# instead of stalling A-only battles. Route 209 trainers are lv 14-19 (trdata.json #46 #47 #48 #49 #53 #55
# #294 #308): one Surf from EMPOLEON 60 each. Staraptor carries the field moves and fights only in true doubles
# (Twins Emma & Lil trdata.json #294, Young Couple Ty & Sue #55).
party SPECIES_EMPOLEON 60 ITEM_NONE
party-move 0 0 MOVE_SURF
party-move 0 1 MOVE_NONE
party-move 0 2 MOVE_NONE
party-move 0 3 MOVE_NONE
party SPECIES_STARAPTOR 50 ITEM_NONE
party-move 1 0 MOVE_AERIAL_ACE
party-move 1 1 MOVE_ROCK_SMASH
party-move 1 2 MOVE_CUT
# @@PRIOR@@
# -- start --
map MAP_HEARTHOME 486 718 FACE_DOWN  # 19's end: on zone_event 0085 coord 0 (484..489,718), inert once 0x407B == 2 (scr_seq 0090 @0x013B)
