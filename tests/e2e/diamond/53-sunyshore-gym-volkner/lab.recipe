# Diamond story 53-sunyshore-gym-volkner: standalone start (--lab, or no end save from 52-route222-sunyshore-flint-lighthouse).
# Standard header + lab party + the cumulative state after 52-route222-sunyshore-flint-lighthouse, then the milestone's start.
# Opponents here: Volkner trdata.json #320 (RAICHU 46, AMBIPOM 47, OCTILLERY 47, LUXRAY 49) + gym trainers #281 #285 #301 #302 #303 #331 #341 #344 (lv 41-44).
name GQ
gender PLAYER_GENDER_MALE
trainer-id 31415
money 20000
# Lab party for S11 (Spear Pillar -> credits). Level 100: no EXP/learn-move/evolution prompts; GiveMon makes the player the
# OT, so no obedience check. The three battle mons carry ONE move each, so an empty slot 0 falls back to Struggle instead
# of stalling A-only battles: the E4 + Champion run has no heal between rooms (26 opponents + up to 12 Full Restores,
# trdata.json #261 #262 #263 #264 #267). Dragon Claw is neutral or better against every required opponent except Steelix
# (trdata.json #263) and Bronzong (#264), which it still 3HKOs at level 100; Crunch backs up. 5 mons: one slot stays free.
party SPECIES_GARCHOMP 100 ITEM_NONE
party-move 0 0 MOVE_DRAGON_CLAW
party-move 0 1 MOVE_NONE
party-move 0 2 MOVE_NONE
party-move 0 3 MOVE_NONE
party SPECIES_SALAMENCE 100 ITEM_NONE
party-move 1 0 MOVE_DRAGON_CLAW
party-move 1 1 MOVE_NONE
party-move 1 2 MOVE_NONE
party-move 1 3 MOVE_NONE
party SPECIES_TYRANITAR 100 ITEM_NONE
party-move 2 0 MOVE_CRUNCH
party-move 2 1 MOVE_NONE
party-move 2 2 MOVE_NONE
party-move 2 3 MOVE_NONE
# field-move carriers, never in front: Surf/Waterfall (Route 223, Victory Road), Strength/Rock Climb (Victory Road),
# Fly (leaving Mt. Coronet), Rock Smash (Victory Road 2F breakrocks, zone_event 0238 objects 14,26-31)
party SPECIES_BIBAREL 100 ITEM_NONE
party-move 3 0 MOVE_SURF
party-move 3 1 MOVE_WATERFALL
party-move 3 2 MOVE_STRENGTH
party-move 3 3 MOVE_ROCK_CLIMB
party SPECIES_STARAPTOR 100 ITEM_NONE
party-move 4 0 MOVE_FLY
party-move 4 1 MOVE_ROCK_SMASH
party-move 4 2 MOVE_NONE
party-move 4 3 MOVE_NONE
# @@PRIOR@@
# -- start --
warp MAP_SUNYSHORE_GYM_ROOM_1 0  # (8,14), zone_event 0153 warp 0
