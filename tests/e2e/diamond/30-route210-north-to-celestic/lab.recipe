# Diamond story 30-route210-north-to-celestic: standalone start (--lab, or no end save from 29-route210-psyduck-old-charm).
# Standard header + lab party + the cumulative state after 29-route210-psyduck-old-charm, then the milestone's start. Names resolve
# through tests/gameplay/labc.py --game diamond; flag/var lines cite the D/P script that sets them.
name GQ
gender PLAYER_GENDER_MALE
trainer-id 31415
money 20000
# Standard lab party (Platinum exemplar): Surf in slot 0 and slots 1-3 cleared, so an empty Surf falls back to
# Struggle instead of stalling A-only battles. Staraptor carries the field moves (Rock Smash, Cut) and fights only
# in true doubles.
# Opponents: Route 210 North sight trainers (zone_event 0348 objects 0-10): strongest TRAINER_DRAGON_TAMER_PATRICK
# trdata.json #73 GIBLE 39; true double TRAINER_DOUBLE_TEAM_ZAC_JEN #75 GYARADOS 27 + RAICHU 27 (Staraptor joins).
party SPECIES_EMPOLEON 60 ITEM_NONE
party-move 0 0 MOVE_SURF
party-move 0 1 MOVE_NONE
party-move 0 2 MOVE_NONE
party-move 0 3 MOVE_NONE
party SPECIES_STARAPTOR 50 ITEM_NONE
party-move 1 0 MOVE_AERIAL_ACE
party-move 1 1 MOVE_ROCK_SMASH
party-move 1 2 MOVE_CUT
# @@PRIOR@@
# -- start --
map MAP_ROUTE_210_SOUTH 561 588 FACE_UP  # 29's end, below the Psyduck's tile (561,587) (zone_event 0347 object 19, hidden 0x1CE)
