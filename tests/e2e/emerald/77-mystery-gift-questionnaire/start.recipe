# 77 Mystery Gift: a save without FLAG_SYS_MYSTERY_GIFT_ENABLE (the new-game base never sets it), in Oldale Town's
# Poke Mart. The questionnaire's phrase only counts with the Pokedex (data/scripts/questionnaire.inc:29-31).
pokedex 1                                # FLAG_SYS_POKEDEX_GET: data/maps/LittlerootTown_ProfessorBirchsLab/scripts.inc (Birch's Pokedex)
# a Pokemon seen in the Pokedex puts the POKeMON group first in the Easy Chat group list (src/easy_chat.c:5613-5623),
# the order the key counts below assume; the starter is one
flag FLAG_SYS_POKEMON_GET                # data/maps/Route101/scripts.inc:217
party SPECIES_MUDKIP 10 ITEM_NONE
# below the questionnaire on the counter (MB_QUESTIONNAIRE at (0,4) of OldaleTown_Mart's layout: tests/e2e/gba_world.py
# World.tile; src/field_control_avatar.c:407-408 -> EventScript_Questionnaire)
map MAP_OLDALE_TOWN_MART 0 5
