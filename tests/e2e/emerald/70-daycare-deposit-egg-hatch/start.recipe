# 70 Day Care: a Ditto from another trainer, the player's Mudkip, a Magikarp and a Zigzagoon, inside the Route 117
# Day Care. Emerald's lady refuses a deposit that would leave one Pokemon (CountPartyAliveNonEggMons == 2 ->
# OnlyTwoAliveMons, data/scripts/day_care.inc:86-90,130-133), so the party is four: after DITTO and MAGIKARP go in,
# MUDKIP and ZIGZAGOON stay. Ditto breeds with anything outside the Undiscovered group; a Ditto pair with different
# OT ids scores PARENTS_MED_COMPATIBILITY (50) per egg roll, the same OT 20 (src/daycare.c:1037-1043): the Ditto
# comes from trainer 27182 (a trade), the rest from the player (31415). `party` gives each Pokemon the save's trainer
# id at that line.
trainer-id 27182
party SPECIES_DITTO 10 ITEM_NONE         # slot 0: EGG_GROUP_DITTO (src/daycare.c:1040)
trainer-id 31415
party SPECIES_MUDKIP 10 ITEM_NONE        # slot 1: stays in the party
party SPECIES_MAGIKARP 10 ITEM_NONE      # slot 2: WATER_2/DRAGON, eggCycles 5 (src/data/pokemon/species_info.h:3899-3902): the egg is a Magikarp
party SPECIES_ZIGZAGOON 10 ITEM_NONE     # slot 3: the third Pokemon left after one deposit (day_care.inc:88-89)
# Running Shoes, so pace/hatch run (B held): Mom gives them in Littleroot (data/maps/LittlerootTown/scripts.inc:836)
flag FLAG_SYS_B_DASH                     # data/maps/LittlerootTown/scripts.inc:836
# the start menu's POKEMON entry, to show the hatched MAGIKARP (src/start_menu.c:321-324)
flag FLAG_SYS_POKEMON_GET                # data/maps/Route101/scripts.inc:217
# inside the Day Care, south of the lady's counter: the lady (Route117_PokemonDayCare/map.json object_events[0] (2,2))
# is spoken to across the counter (2,3) from (2,4)
map MAP_ROUTE117_POKEMON_DAY_CARE 2 5
