# The Trick House's first puzzle (Cut trees), on the GBA new-game base save (Brendan in the house 1F).
flag FLAG_SYS_POKEMON_GET                 # data/maps/Route101/scripts.inc:217 (Birch's bag)
badge 1                                   # data/maps/RustboroCity_Gym/scripts.inc:19: Cut in the field (src/party_menu.c:3725, FIELD_MOVE_CUT 0)
# a lead that cuts the puzzle's trees (HM01, data/maps/RustboroCity_CuttersHouse/scripts.inc:9) and beats Sally, Eddie
# and Robin (src/data/trainer_parties.h:4375-4385 Eddie: Zigzagoon 14, 16; :8103-8108 Sally: Oddish 16; :8111-8126
# Robin: Skitty, Shroomish, Marill 14)
party SPECIES_SWAMPERT 40 ITEM_NONE
party-move 0 3 MOVE_CUT
# Route 110 below the Trick House door (data/maps/Route110/map.json warp_events[1] (11,66) -> ROUTE110_TRICK_HOUSE_ENTRANCE)
map MAP_ROUTE110 11 67
