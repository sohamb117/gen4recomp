# 60 Day Care: a Ditto from another trainer, the player's Mudkip and a Magikarp, inside the Route 117 Day Care.
# Ditto breeds with anything outside the Undiscovered group; a Ditto pair with different OT ids scores 50 per egg roll,
# the same OT 20 (src/daycare.c:887-893 GetDaycareCompatibilityScore): the Ditto comes from trainer 27182 (a trade),
# the rest from the player (31415). The `party` verb gives each Pokemon the save's trainer id at that line.
trainer-id 27182
party SPECIES_DITTO 10 ITEM_NONE         # slot 0: eggGroup DITTO (src/data/pokemon/base_stats.h:4391-4392)
trainer-id 31415
party SPECIES_MUDKIP 10 ITEM_NONE        # slot 1: stays in the party (CountAlivePartyMonsExceptSelectedOne, day_care.inc:108-110)
party SPECIES_MAGIKARP 10 ITEM_NONE      # slot 2: WATER_2/DRAGON, eggCycles 5 (base_stats.h:4268-4293): the egg is a Magikarp
# Running Shoes, so pace/hatch run (B held): Mom gives them in Littleroot (data/maps/LittlerootTown/scripts.inc:861)
flag FLAG_SYS_B_DASH                     # data/maps/LittlerootTown/scripts.inc:861
# the start menu's POKEMON entry, to show the hatched MAGIKARP (src/start_menu.c:267-268)
flag FLAG_SYS_POKEMON_GET                # data/maps/Route101/scripts.inc:220
# inside the Day Care, south of the lady's counter: the lady (Route117_PokemonDayCare/map.json object_events[0] (2,2))
# is spoken to across the counter (2,3) from (2,4)
map MAP_ROUTE117_POKEMON_DAY_CARE 2 5
