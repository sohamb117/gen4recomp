{
  "name": "nativeplat-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:cores": "node scripts/prepare-cores.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "pretest": "node scripts/prepare-test.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "verify:cores": "node scripts/verify-cores.mjs",
    "release": "npm run sync:cores && npm test && npm run build && node scripts/package.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.html",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "verify:options": "node --liftoff-only --import tsx scripts/verify-options.ts",
    "sync:cores": "npm run build:cores && NP_GUEST_WASM_platinum=../build/web-guest/platinum.wasm NP_GUEST_WASM_diamond=../build/web-guest/diamond.wasm NP_GUEST_WASM_pearl=../build/web-guest/pearl.wasm npm run prepare:cores -- platinum diamond pearl --optimize && npm run verify:cores -- platinum diamond pearl && npm run verify:options -- platinum diamond pearl",
    "build:pearl": "python3 scripts/build-pearl-copy.py",
    "build:cores": "python3 scripts/build-cores-copy.py platinum diamond pearl",
    "verify:first-save": "node --liftoff-only --import tsx scripts/verify-first-save.ts",
    "verify:deployment": "node --liftoff-only --import tsx scripts/verify-deployment.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "binaryen": "^123.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
